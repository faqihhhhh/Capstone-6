<Project>
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <ResourceId>/subscriptions/5b6a7150-532d-42a5-b7d9-a2b223519de1/resourceGroups/rg1/providers/Microsoft.Web/sites/ids-esl</ResourceId>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://ids-esl.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>064b860b-9d38-4c95-8baf-0098f2dd7d2e</ProjectGuid>
    <publishUrl>ftps://waws-prod-dm1-293.ftp.azurewebsites.windows.net</publishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <FtpPassiveMode>true</FtpPassiveMode>
    <FtpSitePath>site/wwwroot</FtpSitePath>
    <UserName>ids-esl\$ids-esl</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>